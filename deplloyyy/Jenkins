pipeline {
    agent any

  environment {
        JAVA_HOME = 'C:\\Program Files\\Zulu\\zulu-17'
        PATH = "${JAVA_HOME}\\bin;${env.PATH}"
    }
 
    triggers {
        cron('H 9 * * 1')
    }
 
    stages {
 
        stage('Clean') {
            steps {
                dir('deplloyyy') {
                    bat 'mvn clean'
                }
            }
        }
 
        stage('Test') {
            steps {
                dir('deplloyyy') {
                    bat 'mvn test'
                }
            }
        }
 
        stage('Verify') {
            steps {
                dir('deplloyyy') {
                    bat 'mvn verify'
                }
            }
        }
 
        stage('Package') {
            steps {
                dir('deplloyyy') {
                    bat 'mvn package'
                }
            }
        }
 
        stage('Deploy') {
            steps {
                dir('deplloyyy') {
                    bat 'mvn deploy -s C:\\Users\\10361687\\.m2\\settings.xml'
                }
            }
        }
    }
    post {
    success {
        emailext(
            to: 'avanthikasharma11@gmail.com',
            subject: "Build Successful",
            body: "Build Passed"
        )
    }
 
    failure {
        emailext(
            to: 'avanthikasharma11@gmail.com',
            subject: "Build Failed",
            body: "Build Failed"
        )
    }
}
 
}
 
